{
  "name": "minecraft-bots",
  "version": "1.0.0",
  "description": "6 autonomous Minecraft bots (Mineflayer) with a web control panel: woodcutter, miner, farmer, fisher, rancher and organizer",
  "main": "panel.js",
  "license": "MIT",
  "author": "IndeedMcKenzie",
  "repository": {
    "type": "git",
    "url": "https://github.com/IndeedMcKenzie/minecraft-bots.git"
  },
  "keywords": ["minecraft", "mineflayer", "minecraft-bot", "papermc", "automation"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node panel.js",
    "woodcutter": "node bots/woodcutter.js",
    "miner": "node bots/miner.js",
    "farmer": "node bots/farmer.js",
    "fisher": "node bots/fisher.js",
    "organizer": "node bots/organizer.js",
    "rancher": "node bots/rancher.js"
  },
  "dependencies": {
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-tool": "^1.2.0",
    "mineflayer-auto-eat": "^5.0.3",
    "minecraft-data": "^3.68.0",
    "vec3": "^0.1.10"
  }
}
